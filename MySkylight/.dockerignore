# Keep the build context small and the image reproducible. node_modules is
# installed inside the image (host-built ones may hold the wrong platform's
# native binaries), and .next would otherwise shadow the container's own build.
node_modules
.next
out
build
coverage

# Never bake real secrets into an image layer. Values the build genuinely needs
# arrive as build args (see Dockerfile).
.env
.env.*
!.env.example

.git
.gitignore
Dockerfile
.dockerignore
netlify.toml
README.md
AGENTS.md
*.md
*.tsbuildinfo
.DS_Store
npm-debug.log*
