# Local development. Copy to `.env.local` and fill in real values:
#
#   cp .env.example .env.local
#
# Production values do NOT live here — they're set on the home server in
# HomeServerAPI/.env, which feeds them to the container as build args and
# runtime env (see that repo's .env.example).

# Clerk → API Keys. Use the development instance (pk_test_/sk_test_) locally;
# it accepts any origin, so localhost works without extra domain config.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# Name of the Clerk JWT template the backend validates. Both copies are read by
# the proxy route (server-side first, public as fallback) — keep them identical.
CLERK_JWT_TEMPLATE=skylight-api
NEXT_PUBLIC_CLERK_JWT_TEMPLATE=skylight-api

# Where app/api/backend/[...path] forwards API calls. Local backend by default —
# see HomeServerAPI/README.md for running skylight-api on port 8001. In production
# this is the Compose service name (http://skylight-api:8001), so API traffic never
# leaves the host.
API_BASE_URL=http://localhost:8001
