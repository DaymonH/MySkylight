# ── Clerk ──────────────────────────────────────────────────────────────────────
# From your Clerk dashboard → API Keys
CLERK_SECRET_KEY=sk_test_...
# From Clerk dashboard → API Keys → JWKS endpoint
# Format: https://<your-clerk-domain>.clerk.accounts.dev/.well-known/jwks.json
CLERK_JWKS_URL=https://your-clerk-domain.clerk.accounts.dev/.well-known/jwks.json
# From Clerk dashboard → Webhooks → signing secret
CLERK_WEBHOOK_SECRET=whsec_...

# ── Database ───────────────────────────────────────────────────────────────────
# Production: DB is stored in the Docker volume mounted at /app/data/
DATABASE_URL=sqlite+aiosqlite:////app/data/myskylight.db

# ── App ────────────────────────────────────────────────────────────────────────
APP_ENV=production
# Comma-separated origins allowed to call this API
CORS_ORIGINS=https://myskylight.yourdomain.com,http://localhost:3000

# Allowed hostnames (prevents Host header attacks)
ALLOWED_HOSTS=skylight-api.yourdomain.com,localhost,127.0.0.1

# ── Pins ───────────────────────────────────────────────────────────────────────
# Pepper for child PIN hashing (keep secret, do not rotate lightly)
PIN_PEPPER=change-me-to-a-random-secret-string

# ── Weather ────────────────────────────────────────────────────────────────────
# Background refresh of cached forecasts (so the device stays fresh without anyone
# opening the app). Set WEATHER_REFRESH_ENABLED=false to disable the scheduler.
WEATHER_REFRESH_ENABLED=true
WEATHER_REFRESH_MINUTES=30

# ── Gemini (Magic Import / AI) ───────────────────────────────────────────────
# Google AI Studio API key (https://aistudio.google.com/apikey). Left blank, the
# /magic-import endpoints return 503. GEMINI_MODEL optionally overrides the model id.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
