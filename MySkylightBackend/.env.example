# ── Clerk ──────────────────────────────────────────────────────────────────────
# From your Clerk dashboard → API Keys
CLERK_SECRET_KEY=sk_test_...
# From Clerk dashboard → API Keys → JWKS endpoint
# Format: https://<your-clerk-domain>.clerk.accounts.dev/.well-known/jwks.json
CLERK_JWKS_URL=https://your-clerk-domain.clerk.accounts.dev/.well-known/jwks.json
# From Clerk dashboard → Webhooks → signing secret
CLERK_WEBHOOK_SECRET=whsec_...

# ── Database ───────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./myskylight.db

# ── App ────────────────────────────────────────────────────────────────────────
APP_ENV=development
# Comma-separated origins for CORS (frontend dev server)
CORS_ORIGINS=http://localhost:3000

# ── Pins ───────────────────────────────────────────────────────────────────────
# Pepper for child PIN hashing (keep secret, do not rotate lightly)
PIN_PEPPER=change-me-to-a-random-secret-string
